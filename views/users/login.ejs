<%layout('layouts/boilerplate')%>
    <div class="container d-flex justify-content-center align-items-center mb-3">
        <div class="row">
            <div class="col-md-6 offset-md-3 col-xl-4 offset-xl-4 ">
                <div class="card shadow">
                    <img src="https://images.unsplash.com/photo-1571863533956-01c88e79957e?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1267&q=80"
                        alt="" class="card-img-top" crossorigin/>
                    <div class="card-body">
                        <h5 class="card-title">Acceso</h5>
                        <form action="/login" method="POST" class="validated-form" novalidate>
                            <div class="mb-3">
                                <label class="form-label" for="username">Correo Electrónico</label>
                                <input class="form-control" type="email" id="username" name="username" placeholder="Email Address"  autofocus
                                    required>
                                <div class="valid-feedback">
                                    ¡Se ve Bien!
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="password">Contraseña</label>
                                <input class="form-control" type="password" id="password" name="password" placeholder="Password"  required>
                                <div class="valid-feedback">
                                   ¡Se ve Bien! 
                                </div>
                            </div>
                            <button class="btn btn-success btn-block">Acceso</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
