<!-- @format -->

<% layout('layouts/boilerplate')%>
<link
	rel="stylesheet"
	href="/stylesheets/stars.css" />
<div class="row">
	<div class="col-sm-6">
		<div
			id="parkCarousel"
			class="carousel slide carousel-fade"
			data-ride="carousel">
			<div class="carousel-inner">
				<%park.images.forEach((img, i)=> { %>
				<div class="carousel-item <%= i === 0 ? 'active' : ''%>">
					<a
						href="<%=img.url%>"
						target="_blank"
						><img
							src="<%=img.url%>"
							class="img-fluid"
							alt=""
							crossorigin
					/></a>
				</div>
				<% }) %>
			</div>
			<% if(park.images.length > 1) {%>
			<a
				class="carousel-control-prev"
				href="#parkCarousel"
				role="button"
				data-slide="prev">
				<span
					class="carousel-control-prev-icon"
					aria-hidden="true"></span>
				<span class="sr-only">Previous</span>
			</a>
			<a
				class="carousel-control-next"
				href="#parkCarousel"
				role="button"
				data-slide="next">
				<span
					class="carousel-control-next-icon"
					aria-hidden="true"></span>
				<span class="sr-only">Next</span>
			</a>
			<% } %>
		</div>
		<div class="card border-light mb-3">
			<div class="card-body">
				<h5 class="card-title"><%=park.title%></h5>
				<p
					class="card-text"
					style="white-space: pre-wrap">
					<%=park.description%>
				</p>
			</div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item">
					Rango de precio: <span><%=park.price%></span>
				</li>
				<% if( currentUser && park.author.equals(currentUser._id)) {%>
				<li class="list-group-item"><%=park.author.username%></li>
			</ul>
			<div class="card-body">
				<a
					class="card-link btn btn-info"
					href="/parks/<%=park._id%>/editPark"
					>Editar</a
				>
				<form
					class="d-inline"
					action="/parks/<%=park._id%>?_method=DELETE"
					method="POST">
					<button class="btn btn-danger">Eliminar</button>
				</form>
			</div>
			<% } %>
		</div>
	</div>
	<div class="col-sm-6">
		<div class="mb-3">
			<div id="parkmap"></div>
		</div>
		<div class="mb-3">
			<a
				class="btn btn-info"
				style="color: #df7825"
				target="_blank"
				rel="noopener"
				href="https://www.google.com/maps/search/?api=1&query=<%=park.title%>"
				>Google</a
			>
		</div>
		<h3>Dejar un Comentario</h3>
		<form
			action="/parks/<%=park._id%>/parkreviews"
			method="POST"
			class="validated-form"
			novalidate>
			<fieldset class="starability-basic">
				<input
					type="radio"
					id="no-rate"
					class="input-no-rate"
					name="parkReview[rating]"
					value="0"
					checked
					aria-label="No rating." />
				<input
					type="radio"
					id="first-rate1"
					name="parkReview[rating]"
					value="1" />
				<label
					for="first-rate1"
					title="Terrible"
					>1 Estrellas</label
				>
				<input
					type="radio"
					id="first-rate2"
					name="parkReview[rating]"
					value="2" />
				<label
					for="first-rate2"
					title="Not good"
					>2 Estrellas</label
				>
				<input
					type="radio"
					id="first-rate3"
					name="parkReview[rating]"
					value="3" />
				<label
					for="first-rate3"
					title="Average"
					>3 Estrellas</label
				>
				<input
					type="radio"
					id="first-rate4"
					name="parkReview[rating]"
					value="4" />
				<label
					for="first-rate4"
					title="Very good"
					>4 Estrellas</label
				>
				<input
					type="radio"
					id="first-rate5"
					name="parkReview[rating]"
					value="5" />
				<label
					for="first-rate5"
					title="Amazing"
					>5 Estrellas</label
				>
			</fieldset>
			<div class="mb-3">
				<label
					class="form-label"
					for="body"></label>
				<textarea
					class="form-control"
					name="parkReview[body]"
					id="body"
					cols="30"
					rows="3"
					placeholder="Deja tus comentarios aquí"
					required></textarea>
				<div class="valid-feedback">¡se ve bien!</div>
			</div>

			<% if(currentUser){ %>
			<button class="btn btn-success">Enviar</button>
			<% } else { %>
			<a href="/login?returnTo=/parks/<%= park._id %>"
				>Inicie sesión o regístrese para dejar una reseña</a
			>
			<% } %>
		</form>

		<% for(let parkReview of park.parkReviews) { %>
		<div class="card mb-3 mt-3">
			<div class="card-body">
				<h5 class="card-title"><%= parkReview.author.username%></h5>
				<p
					class="starability-result"
					data-rating="<%=parkReview.rating%>"></p>
				<p class="card-text">comentario: <%= parkReview.body %></p>
				<% if( currentUser && parkReview.author.equals(currentUser._id)) {%>
				<form
					action="/parks/<%=park._id%>/parkreviews/<%=parkReview._id%>?_method=DELETE"
					method="POST">
					<button class="btn btn-sm btn-danger">Eliminar</button>
				</form>
				<% } %>
			</div>
		</div>
		<% } %>
	</div>
</div>

<script>
	const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
	const park = <%-JSON.stringify(park) %>
</script>

<script src="/javascripts/showParkMap.js"></script>
