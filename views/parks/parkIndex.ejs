<% layout('layouts/boilerplate')%>
  <section class="container-fluid px-0">
    <div class="row">
      <div class="col-sm-6 position-fixed">
        <div id="parkscluster-map"></div>
      </div>
    </div>
    <div class="row align-items-center">
        <% for (let park of parks) { %>
          <% if (park.premium == 'true') {%>
          <div class="col-sm-6"></div>
          <div class="col-sm-6 d-none d-sm-block mb-3">
            <div class="card-group" id="indexCards">
              <div class="card">
                <% if (park.images.length) { %>
                  <img src="<%=park.images[0].url%>" class="card-img-top" alt="" crossorigin>
                  <% } else { %>
                    <img class="card-img-top" alt=""
                      src="https://res.cloudinary.com/douqbebwk/image/upload/v1600103881/YelpCamp/lz8jjv2gyynjil7lswf4.png" crossorigin>
                  <% } %>
                    <div class="card-body">
                      <a href="/parks/<%=park._id%>" id="parkTitleIndex"><h4 class="card-title" style="color: #df7825;"><%= park.title %></h4></a>
                    </div>
              </div>
            </div>
          </div>
         <% } %>
        <% } %>
      </div>
    </div>
  </section>
    <script>
      const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
      const parks = { features: <%-JSON.stringify(parks)%>}
    </script>
    <script src="/javascripts/parksClusterMap.js"></script>