<% layout('layouts/boilerplate')%>
  <link rel="stylesheet" href="/stylesheets/stars.css">
  <div class="row">
    <div class="col-sm-6">
      <div id="campgroundCarousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
          <%campground.images.forEach((img, i)=> { %>
            <div class="carousel-item <%= i === 0 ? 'active' : ''%>">
              <img src="<%=img.url%>" class="img-fluid" alt="">
            </div>
            <% }) %>
        </div>
        <% if(campground.images.length > 1) {%>
          <a class="carousel-control-prev" href="#campgroundCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
          </a>
          <a class="carousel-control-next" href="#campgroundCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
          </a>
          <% } %>
      </div>
      <div class="card border-light mb-3">
        <div class="card-body">
          <h5 class="card-title"><%=campground.title%></h5>
          <p class="card-text"><%=campground.description%></p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item text-muted"><a class="btn btn-info" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%=campground.title%>">Indicaciones</a></li>
          <li class="list-group-item">Rango de precio: <span><%=campground.price%></span></li>
        <% if( currentUser && campground.author.equals(currentUser._id)) {%>
          <li class="list-group-item"><%=campground.author.username%></li>
        </ul>
        <div class="card-body">
            <a class="card-link btn btn-info" href="/campgrounds/<%=campground._id%>/edit">Editar</a>
            <form class="d-inline" action="/campgrounds/<%=campground._id%>?_method=DELETE" method="POST">
              <button class="btn btn-danger">Eliminar</button>
            </form>
        </div>
          <% } %>
          <div class="card-footer text-muted">
             <div id="result"></div>
            <script>
              const date = document.lastModified;
              document.getElementById("result").innerHTML = "última visita: " + date;
            </script>
          </div>
      </div>
    </div>
    <div class="col-sm-6">
      <div class="mb-3">
        <div id='map'></div>
      </div>
      
        <h3>Dejar un comentario</h3>
        <form action="/campgrounds/<%=campground._id%>/reviews" method="POST" class="mb-3 validated-form" novalidate>
          <fieldset class="starability-basic">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
              aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 Estrellas</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 Estrellas</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 Estrellas</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 Estrellas</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 Estrellas</label>
          </fieldset>
          <div class="mb-3">
            <label class="form-label" for="body"></label>
            <textarea class="form-control" name="review[body]" id="body" cols="30" rows="3" placeholder="Deja tus comentarios aquí" required></textarea>
            <div class="valid-feedback">
              ¡se ve bien!
            </div>
          </div>
          
            <% if(currentUser){ %>
              <button class="btn btn-success">Enviar</button>
              <% } else { %>
                <a href="/login?returnTo=/campgrounds/<%= campground._id %>">Inicia sesión para añadir una reseña</a>
              <% } %>
        </form>
            
          <% for(let review of campground.reviews) { %>
            <div class="card mb-3 mt-3">
              <div class="card-body">
                <h5 class="card-title">
                  <%= review.author.username%>
                </h5>
                   <p class="starability-result" data-rating="<%=review.rating%>">                      
                   </p>
                   <p class="card-text">comentario: <%= review.body %>
                   </p>
                <% if( currentUser && review.author.equals(currentUser._id)) {%>
                  <form action="/campgrounds/<%=campground._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                    <button class="btn btn-sm btn-danger">Eliminar</button>
                  </form>
                  <% } %>
              </div>
            </div>
          <% } %>
    </div>
  </div>

  <script>
    const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
    const campground = <%-JSON.stringify(campground) %>
  </script>

  <script src="/javascripts/showPageMap.js"></script>